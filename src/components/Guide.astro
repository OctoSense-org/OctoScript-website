---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import ComponentCatalog from './ComponentCatalog.astro';
import ArchitectureFlow from './architecture/ArchitectureFlow';
import ComponentLab from './ComponentLab.astro';
import { guidesFor } from '../data/docs';
import { content, route, repository, type Locale } from '../data/content';
interface Props { locale: Locale; slug: string; }
const { locale, slug } = Astro.props;
const guides = guidesFor(locale);
const guide = guides.find(item => item.slug === slug)!;
const c = content[locale];
const Content = guide.Content;
// Keep the original Markdown h1, introduction and heading IDs. The graph gets
// a full-width row between the introduction and the first prose section.
const architectureHtml = slug === 'octosense-apps' ? await guide.compiledContent() : '';
const firstSection = architectureHtml.indexOf('<h2');
if (architectureHtml && firstSection < 0) throw new Error('App guide needs a section after its introduction');
const introduction = architectureHtml.slice(0, firstSection);
const remainingGuide = architectureHtml.slice(firstSection);
---
<Layout locale={locale} title={`${guide.title} — Octoscript`} description={guide.description} path={`docs/${slug}/`}>
  <main id="main" class="container doc-layout">
    {architectureHtml && <>
      <article class="prose architecture-lead"><span class="eyebrow">{c.guideLabel} / {guide.tag}</span><Fragment set:html={introduction}/></article>
      <div class="architecture-row"><ArchitectureFlow locale={locale} client:load /></div>
    </>}
    <aside class="doc-sidebar" aria-label={c.docsHome}>
      <a class="docs-back" href={route(locale, 'docs/')}><span>←</span>{c.docsHome}</a>
      <span class="eyebrow">OCTOSCRIPT</span>
      <nav aria-label={locale === 'cn' ? '开发指南' : 'Developer guides'}>{guides.map(item => <a href={route(locale, `docs/${item.slug}/`)} aria-current={item.slug === slug ? 'page' : undefined}>{item.title}<Icon name="chevron" size={13}/></a>)}</nav>
      <a class="sidebar-source" href={repository}>{c.source}<Icon name="diagonal" size={14}/></a>
    </aside>
    <div class="doc-content">{!architectureHtml && <span class="eyebrow">{c.guideLabel} / {guide.tag}</span>}<article class="prose">{architectureHtml ? <Fragment set:html={remainingGuide}/> : <Content />}</article>{slug === 'component-library' && <><ComponentLab locale={locale}/><ComponentCatalog locale={locale}/></>}<a class="text-link doc-bottom" href={route(locale, 'docs/')}><span>←</span>{c.allDocs}</a></div>
    <aside class="doc-toc" aria-label={c.onPage}><span class="eyebrow">{c.onPage}</span><nav>{architectureHtml && <a href="#architecture-explorer">{locale === 'cn' ? '交互式架构图' : 'Interactive architecture'}</a>}{guide.headings.filter((heading: {depth: number}) => heading.depth === 2).map((heading: {slug: string; text: string}) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav></aside>
  </main>
</Layout>
